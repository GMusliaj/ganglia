{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FAFO experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "experiment_id",
    "uncertainty",
    "contracts",
    "success_condition",
    "failure_condition",
    "preflight",
    "budget",
    "stop_condition"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "fafo-plan"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "uncertainty": {"type": "string", "minLength": 1},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "success_condition": {"type": "string", "minLength": 1},
    "failure_condition": {"type": "string", "minLength": 1},
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_class",
        "working_directory",
        "targets",
        "baseline",
        "ownership",
        "dirty_state",
        "overlap_targets",
        "preview",
        "authorization_basis",
        "rollback",
        "retry_semantics",
        "reconciliation_check",
        "independent_postcondition"
      ],
      "properties": {
        "effect_class": {
          "type": "string",
          "enum": ["read-only", "temporary-local", "repository-local"]
        },
        "working_directory": {"type": "string", "minLength": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "baseline": {"type": "string", "minLength": 1},
        "ownership": {"type": "string", "minLength": 1},
        "dirty_state": {
          "type": "string",
          "enum": ["clean", "unrelated-changes-preserved"]
        },
        "overlap_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence"],
          "properties": {
            "status": {"type": "string", "enum": ["passed", "not-applicable"]},
            "evidence": {"type": "string", "minLength": 1}
          }
        },
        "authorization_basis": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1},
        "retry_semantics": {
          "type": "string",
          "enum": ["not-needed", "idempotent", "reconcile-before-retry"]
        },
        "reconciliation_check": {"type": "string", "minLength": 1},
        "independent_postcondition": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_actions", "timeout_seconds", "resource_limit"],
      "properties": {
        "max_actions": {"type": "integer", "minimum": 1, "maximum": 5},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "resource_limit": {"type": "string", "minLength": 1}
      }
    },
    "stop_condition": {"type": "string", "minLength": 1}
  }
}
