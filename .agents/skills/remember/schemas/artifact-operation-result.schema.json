{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/brain/artifact-operation-result.schema.json",
  "title": "Brain artifact operation result",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "operation",
    "artifact_id",
    "manifest",
    "payload",
    "bundle_digest",
    "evidence_digest",
    "verification",
    "written"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "artifact-operation-result"
    },
    "operation": {
      "type": "string",
      "enum": ["prepare", "verify", "publish"]
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "string",
      "minLength": 1
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verification": {
      "type": "object",
      "required": ["status", "verified_at", "checks"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "unverified"]
        },
        "verified_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": {
                "type": "string",
                "enum": ["python-syntax", "javascript-syntax", "shell-syntax", "help-output", "focused-test", "representative-run"]
              },
              "status": {
                "type": "string",
                "enum": ["passed", "failed", "unavailable", "authorization-blocked"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "written": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
