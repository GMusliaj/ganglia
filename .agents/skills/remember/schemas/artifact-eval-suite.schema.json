{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ganglia/artifact-eval-suite.schema.json",
  "title": "Ganglia artifact evaluation suite",
  "type": "object",
  "required": ["schema_version", "kind", "cases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "artifact-eval-suite"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "assertion", "expected_behavior"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "category": {
            "type": "string",
            "enum": ["materialization", "review", "verification", "retrieval", "safety", "privacy", "update", "protocol"]
          },
          "assertion": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "expected_behavior": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
