{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ganglia/artifact-candidate.schema.json",
  "title": "Ganglia artifact candidate",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "artifact_id",
    "title",
    "description",
    "type",
    "tags",
    "date",
    "payload_name",
    "language",
    "runtime",
    "invocation",
    "working_directory",
    "dependencies",
    "arguments",
    "environment",
    "inputs",
    "outputs",
    "exit_behavior",
    "applicability",
    "safety",
    "mutation_default",
    "purpose",
    "focused_test",
    "representative_run"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "artifact-candidate"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "snippet"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "payload_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*\\.(?:py|mjs|sh)$"
    },
    "language": {
      "type": "string",
      "enum": ["python", "javascript", "shell"]
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "invocation": {
      "type": "string",
      "minLength": 1
    },
    "working_directory": {
      "type": "string",
      "const": "ganglia-root"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "arguments": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*=EXAMPLE_[A-Z0-9_]+$"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "exit_behavior": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 2,
      "uniqueItems": true
    },
    "applicability": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "safety": {
      "type": "string",
      "enum": ["read-only", "mutating"]
    },
    "mutation_default": {
      "type": "string",
      "enum": ["read-only", "preview"]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "focused_test": {
      "type": "object",
      "required": ["arguments", "expected_stdout"],
      "properties": {
        "arguments": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "expected_stdout": {"type": "string"}
      },
      "additionalProperties": false
    },
    "representative_run": {
      "type": "object",
      "required": ["arguments", "expected_stdout"],
      "properties": {
        "arguments": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "expected_stdout": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
