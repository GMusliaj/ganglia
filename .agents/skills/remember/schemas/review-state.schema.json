{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ganglia/review-state.schema.json",
  "title": "Ganglia reduced artifact review state",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "review_id",
    "base_revision",
    "producer",
    "artifact_id",
    "bundle_digest",
    "evidence_digest",
    "status",
    "agreement",
    "accepted_lenses",
    "missing_lenses",
    "blockers",
    "contributions",
    "next_revision",
    "exhausted"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "review-state"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "review_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "base_revision": {"type": "integer", "minimum": 0},
    "producer": {"type": "string", "const": "reducer"},
    "artifact_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^(?:none|sha256:[0-9a-f]{64})$"},
    "status": {"type": "string", "enum": ["agreement", "blocked", "incomplete", "exhausted"]},
    "agreement": {"type": "boolean"},
    "accepted_lenses": {
      "type": "array",
      "items": {"type": "string", "enum": ["scriptability", "execution-risk", "retrieval-economics"]},
      "uniqueItems": true
    },
    "missing_lenses": {
      "type": "array",
      "items": {"type": "string", "enum": ["scriptability", "execution-risk", "retrieval-economics"]},
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["producer", "id", "path", "line_start", "line_end", "body", "recommendation", "confidence"],
        "properties": {
          "producer": {"type": "string", "enum": ["scriptability", "execution-risk", "retrieval-economics"]},
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "body": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "contributions": {"type": "integer", "minimum": 0, "maximum": 3},
    "next_revision": {"type": "integer", "minimum": 0},
    "exhausted": {"type": "boolean"}
  },
  "additionalProperties": false
}
