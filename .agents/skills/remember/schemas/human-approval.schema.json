{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/brain/human-approval.schema.json",
  "title": "Brain artifact human approval",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "producer",
    "artifact_id",
    "bundle_digest",
    "evidence_digest",
    "review_id",
    "base_revision",
    "decision",
    "approved_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "human-approval"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "producer": {"type": "string", "const": "human"},
    "artifact_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "base_revision": {"type": "integer", "minimum": 0},
    "decision": {"type": "string", "enum": ["accepted", "rejected"]},
    "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  },
  "additionalProperties": false
}
