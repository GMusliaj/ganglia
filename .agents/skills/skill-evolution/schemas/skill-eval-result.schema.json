{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill evaluator result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "score", "cases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "skill-eval-result"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "score", "summary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "passed": {"type": "boolean"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
