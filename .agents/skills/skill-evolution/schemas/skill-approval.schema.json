{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human skill approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "proposal_id",
    "skill_name",
    "candidate_digest",
    "proposal_digest",
    "evaluation_digest",
    "producer",
    "decision",
    "candidate_guard",
    "approved_at",
    "approval_digest"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "skill-approval"},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proposal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "producer": {"type": "string", "const": "human"},
    "decision": {"type": "string", "enum": ["accepted", "rejected"]},
    "candidate_guard": {"type": "string", "const": "passed"},
    "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "approval_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
