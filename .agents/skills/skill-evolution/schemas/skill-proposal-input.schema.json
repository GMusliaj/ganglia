{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill proposal input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "skill_name",
    "target_skill",
    "candidate_skill",
    "pattern_keys",
    "rationale",
    "evaluator"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "skill-proposal-input"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "target_skill": {"type": "string", "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"},
    "candidate_skill": {"type": "string", "pattern": "^\\.tmp/.+SKILL\\.md$"},
    "pattern_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "rationale": {"type": "string", "minLength": 1},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "arguments", "timeout_seconds"],
      "properties": {
        "path": {"type": "string", "pattern": "^evals/skills/[A-Za-z0-9._/-]+$"},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    }
  }
}
