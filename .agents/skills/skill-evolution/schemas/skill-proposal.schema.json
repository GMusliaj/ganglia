{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepared skill proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "proposal_id",
    "skill_name",
    "target_skill",
    "pattern_keys",
    "rationale",
    "evaluator",
    "base_digest",
    "candidate_digest",
    "evaluator_digest",
    "baseline_snapshot",
    "candidate_snapshot",
    "prepared_at",
    "proposal_digest"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "skill-proposal"},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "target_skill": {"type": "string", "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"},
    "pattern_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "rationale": {"type": "string", "minLength": 1},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "arguments", "timeout_seconds"],
      "properties": {
        "path": {"type": "string", "pattern": "^evals/skills/[A-Za-z0-9._/-]+$"},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "base_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "baseline_snapshot": {"type": "string", "pattern": "^local/skill-evolution/proposals/.+/baseline/[a-z0-9-]+$"},
    "candidate_snapshot": {"type": "string", "pattern": "^local/skill-evolution/proposals/.+/candidate/[a-z0-9-]+$"},
    "prepared_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "proposal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
