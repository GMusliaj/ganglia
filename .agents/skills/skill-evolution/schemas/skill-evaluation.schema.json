{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content-bound skill evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "proposal_id",
    "skill_name",
    "base_digest",
    "candidate_digest",
    "proposal_digest",
    "evaluator_digest",
    "baseline",
    "candidate",
    "score_delta",
    "regressions",
    "gate_status",
    "evaluated_at",
    "evaluation_digest"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "skill-evaluation"},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "base_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proposal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "score", "cases"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "kind": {"type": "string", "const": "skill-eval-result"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed", "score", "summary"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "passed": {"type": "boolean"},
              "score": {"type": "number", "minimum": 0, "maximum": 1},
              "summary": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "score", "cases"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "kind": {"type": "string", "const": "skill-eval-result"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed", "score", "summary"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "passed": {"type": "boolean"},
              "score": {"type": "number", "minimum": 0, "maximum": 1},
              "summary": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "score_delta": {"type": "number", "minimum": -1, "maximum": 1},
    "regressions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "gate_status": {"type": "string", "enum": ["accepted", "rejected"]},
    "evaluated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "evaluation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
