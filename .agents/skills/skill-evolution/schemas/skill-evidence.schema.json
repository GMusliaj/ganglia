{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stored skill evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "skill_name",
    "task_id",
    "outcome",
    "summary",
    "signals",
    "checks",
    "evidence_id",
    "evidence_digest",
    "captured_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "skill-evidence"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "outcome": {"type": "string", "enum": ["passed", "failed"]},
    "summary": {"type": "string", "minLength": 1},
    "signals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "summary"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"type": "string", "enum": ["success", "failure"]},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "status", "observation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "command": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["passed", "failed", "unavailable"]},
          "observation": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
